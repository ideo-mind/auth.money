{
  "name": "money-auth",
  "private": "true",
  "description": "MoneyPot Authentication Service - Multi-chain wallet verification for treasure hunting",
  "keywords": [
    "aptos",
    "evm",
    "authentication",
    "money-pot",
    "blockchain",
    "wallet-verification"
  ],
  "author": {
    "name": "Hiro",
    "contributors": [
      "Hiro <hiro@ideomind.org>"
    ]
  },
  "license": "See License in the LICENSE file",
  "scripts": {
    "preinstall": "only-allow bun",
    "typings:gen": "npm run cf-typegen",
    "build": "wrangler build && bun x tsc --noEmit",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "types": "wrangler types --env-interface Env",
    "pr": "wrangler versions upload"
  },
  "dependencies": {
    "aptos": "^1.20.0",
    "@arkiv-network/sdk": "^0.4.4",
    "base64url": "^3.0.1",
    "crypto": "^1.0.1",
    "hono": "^4.6.20",
    "node-forge": "^1.3.1",
    "viem": "^2.38.0"
  },
  "devDependencies": {
    "@aptos-labs/ts-sdk": "^5.1.0",
    "@cloudflare/workers-types": "^4.20250204.0",
    "@typemove/aptos": "^1.13.3",
    "@types/bluebird": "^3.5.42",
    "@types/bun": "latest",
    "@types/node": "^22.13.1",
    "@types/node-forge": "^1.3.11",
    "@types/readline-sync": "^1.4.8",
    "@types/timed-cache": "^2.0.4",
    "axios": "^1.10.0",
    "bluebird": "^3.7.2",
    "bs58": "^6.0.0",
    "buffer": "^6.0.3",
    "dotenv": "^16.5.0",
    "eslint": "^9",
    "ethers": "^6.14.4",
    "next-buffer": "^1.0.1",
    "only-allow": "^1.2.1",
    "prettier": "^3.5.0",
    "prettier-plugin-organize-imports": "^4.2.0",
    "readline-sync": "^1.4.10",
    "timed-cache": "^2.0.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.41.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}