  const forge = require('node-forge');
  
  // Mock pot data (in real scenario, this comes from blockchain)
  const potId = 'pot_' + Math.random().toString(36).substr(2, 9);
  const creatorAddress = '0x' + Math.random().toString(16).substr(2, 40);
  const currentTime = Math.floor(Date.now() / 1000);
  
  // 1P Configuration
  const password = 'A'; // Single character password
  const legend = {
    'A': 'Up',
    'B': 'Down', 
    'C': 'Left',
    'D': 'Right'
  };
  
  // Create payload
  const payload = {
    pot_id: potId,
    '1p': password,
    legend: legend,
    iat: currentTime,
    iss: creatorAddress,
    '1fa_public_key': "",  
    exp: currentTime + 3600 // 1 hour
  };
  
  
  
  
  // Encrypt payload with RSA public key
  const encrypted = keypair.publicKey.encrypt(JSON.stringify(payload), 'RSA-OAEP', {
    md: forge.md.sha256.create(),
    mgf1: {
      md: forge.md.sha256.create()
    }
  });
  const encryptedHex = forge.util.bytesToHex(encrypted);
  
