POST {{u}}/register/verify
Content-Type: application/json


{
  "encrypted_payload": {{encrypted_payload}}
}

> {%
  const assert = require('assert');
  const body = response.body;
  console.log('Pot Registration Response:', body);
  console.log('Response status:', response.status);
  console.log('Response headers:', response.headers);
  
  if (response.status !== 200) {
    console.log('❌ Registration failed with status:', response.status);
    console.log('Error details:', body);
    throw new Error('Pot registration failed: ' + JSON.stringify(body));
  }
  
  assert.ok(body.success === true, 'Registration not successful');
  console.log('✅ Pot registered successfully with 1P configuration');
%}