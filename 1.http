GET {{u}}/
Content-Type: application/json

> {%
  const assert = require('assert');
  const body = response.body;
  console.log('Service Info Response:', body);
  
  if (response.status !== 200) {
    throw new Error('Service info failed: ' + JSON.stringify(body));
  }
  
  assert.ok(body.service, 'No service name returned');
  assert.ok(body.version, 'No version returned');
  assert.ok(body.endpoints, 'No endpoints returned');
  console.log('✅ Service info retrieved successfully');
%}
###
GET {{u}}/health
Content-Type: application/json

> {%
  const assert = require('assert');
  const body = response.body;
  console.log('Health Check Response:', body);
  
  if (response.status !== 200) {
    throw new Error('Health check failed: ' + JSON.stringify(body));
  }
  
  assert.ok(body.service, 'No service name returned');
  assert.ok(body.status === 'healthy', 'Service not healthy');
  console.log('✅ Service is healthy');
%}
###
POST {{u}}/register/options
Content-Type: application/json

> {%
  const assert = require('assert');
  const body = response.body;
  console.log('RSA Key Pair Response:', body);
  
  if (response.status !== 200) {
    throw new Error('RSA key generation failed: ' + JSON.stringify(body));
  }
  
  assert.ok(body.public_key, 'No public key returned');
  assert.ok(body.key_id, 'No key ID returned');
  

  client.global.set('RSA_PUBLIC_KEY',body.public_key);
  client.global.set('RSA_KEY_ID',body.key_id);

  
  console.log('✅ RSA key pair generated successfully');
  console.log('Key ID:', body.key_id);
%}
