### Route Import Pattern

```typescript
// Main route file (e.g., src/routes/evm/index.ts)
import { Hono } from "hono"
import authenticateRouter from "./authenticate"
import registerRouter from "./register"
import airdropRouter from "./airdrop"
import { IRunningContext } from "@lib/context"
import { useEVMWallet } from "@mw/useEVMWallet"
import { useEVMChain } from "@mw/useEVMChain"

const router = new Hono<IRunningContext>()

router.use("*", useEVMWallet)
router.use("*", useEVMChain)
router.route("/authenticate", authenticateRouter)
router.route("/register", registerRouter)
router.route("/airdrop", airdropRouter)

export default router
```

### Sub-route Pattern

```typescript
// Sub-route file (e.g., src/routes/evm/authenticate/index.ts)
import { Hono } from "hono"
import { IRunningContext } from "@lib/context"

const router = new Hono<IRunningContext>()

router.post("/", async c => {
  try {
    const body = await c.req.json()
    
    // Authentication logic
    const result = await processAuthentication(body)
    
    return c.json(result, 201)
  } catch (error) {
    console.error("Authentication error:", error)
    return c.json({ error: "Authentication failed" }, 500)
  }
})

export default router
```

### Route Registration in Main App

```typescript
// src/index.ts
import aptosRouter from "@routes/aptos"
import evmRouter from "@routes/evm"
import onepRouter from "@routes/1p"
import chainsRouter from "@routes/chains"

const app = new Hono<IRunningContext>()

app.route("/aptos", aptosRouter)
app.route("/evm", evmRouter)
app.route("/1p", onepRouter)
app.route("/chains", chainsRouter)

export default app
```

### Route Naming Conventions

- **Use kebab-case** for route paths (`/authenticate`, `/register`, `/airdrop`)
- **Use descriptive names** that match the API endpoint
- **Group related routes** under common prefixes (`/aptos/*`, `/evm/*`, `/1p/*`)
- **Use RESTful patterns** (`POST /authenticate`, `POST /register`, `GET /chains`)

### Middleware Application

```typescript
// Apply middleware to specific routes
router.use("*", useEVMWallet, useEVMChain)

// Apply middleware to specific methods
router.use("POST", useWalletAuth)

// Apply middleware to specific paths
router.use("/authenticate", useEVMThrottling)
```

### Route Handler Pattern

```typescript
router.post("/", async c => {
  try {
    const body = await c.req.json()

    // Validation
    if (!body.requiredField) {
      return c.json({ error: "Missing required field" }, 400)
    }

    // Business logic
    const result = await processRequest(body)

    // Response
    return c.json(result, 201)
  } catch (error) {
    console.error("Route error:", error)
    return c.json({ error: "Internal server error" }, 500)
  }
})
```

## Security & Authentication

### Multi-Chain Authentication

- Use `useWalletAuth` middleware for EVM wallet verification
- Support Aptos account-based authentication
- Implement 1P Protocol authentication with encrypted payloads
- Use signature verification with `recoverMessageAddress`
- Store authentication state in context variables

### Security Patterns

- Hash-only storage keys for sensitive data
- Validate signature formats before processing
- Implement proper error handling without exposing internals
- Use encrypted payloads for 1P Protocol
- Support multiple authentication methods per chain type

### Wallet Authentication Pattern

```typescript
// EVM Wallet Authentication
export const useWalletAuth: MiddlewareHandler<IRunningContext> = async (c, next) => {
  try {
    const body = await c.req.json<WalletAuthPayload>()
    const { encrypted_payload, signature } = body

    // Parse and verify payload
    const payload = JSON.parse(Buffer.from(encrypted_payload, 'hex').toString('utf-8'))
    
    // Verify signature
    const recoveredAddress = await recoverMessageAddress({
      message: payload.challenge_id || JSON.stringify(payload),
      signature: signature as `0x${string}`,
    })

    // Attach to context
    c.set("wallet_user", recoveredAddress as Address)
    c.set("wallet_payload", payload)
    c.set("wallet_signature", signature)

    return next()
  } catch (error) {
    return c.json({ error: "Wallet authentication failed" }, 500)
  }
}
```

## Multi-Chain Integration

### Chain Configuration

- Use `ChainConfig` interface for chain-specific settings
- Support both Aptos and EVM chains
- Implement chain registry with `CHAIN_REGISTRY`
- Use `getChainConfig()` for chain validation
- Support multiple RPC endpoints and explorers

### Blockchain Patterns

- Use chain-aware clients with `getPublicClient(chainId)`
- Implement multiple nonce management strategies (KV, D1, DO)
- Handle transaction errors gracefully
- Use proper gas estimation with chain-specific adjustments
- Standardize transaction hashes as `Hash` type from viem

### Chain Management Pattern

```typescript
// Chain configuration
export interface ChainConfig {
  chainId: number;
  type: ChainType;
  name: string;
  contractAddress: string;
  rpcUrl: string;
  explorerUrl: string;
}

// Chain middleware
export const useEVMChain: MiddlewareHandler<IRunningContext> = async (c, next) => {
  const chainId = parseInt(c.req.header("CHAIN") || "102031")
  const chainConfig = getChainConfig(chainId)
  
  if (!chainConfig) {
    return c.json({ error: "Unsupported chain" }, 400)
  }

  c.set("chainId", chainId)
  c.set("chainConfig", chainConfig)
  c.set("chainType", "evm")
  
  return next()
}
```

## Testing Strategy

### Test Organization

- Use HTTP files for API testing (`.http` files)
- Organize tests by feature with dependencies
- Use environment variables for configuration
- Follow project-based test organization

### Test File Naming & Structure

- **Main test files**: `*.http` for API testing
- **Integration tests**: `*.integration.http` for complex workflows
- **Feature-specific tests**: `feature-name.http` (e.g., `auth.http`, `airdrop.http`)
- **Chain-specific tests**: `chain-name.http` (e.g., `aptos.http`, `evm.http`)

### HTTP Testing Patterns

```http
### Authentication Test
POST {{baseUrl}}/evm/authenticate
Content-Type: application/json

{
  "encrypted_payload": "{{encryptedPayload}}",
  "signature": "{{signature}}"
}

### Registration Test
POST {{baseUrl}}/1p/register
Content-Type: application/json

{
  "pot_id": "test-pot-123",
  "password": "test-password",
  "legend": {"red": "up", "blue": "down"}
}
```

### Test Best Practices

- **Use descriptive test names** that explain the scenario
- **Group related tests** with comments
- **Handle async operations** with proper polling and timeouts
- **Use environment variables** for test configuration
- **Test both success and error cases**
- **Verify response structure** with property assertions
- **Test CORS headers** for browser compatibility

